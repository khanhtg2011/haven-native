import { Theme } from "../theme.slint";

export component UserBar inherits Rectangle {
    height: 52px;
    background: Theme.bg-user-bar;

    in-out property <string> username: "HavenUser";
    in-out property <string> user-status: "Online";
    in-out property <image> avatar-image;
    in-out property <bool> has-avatar: false;
    in-out property <string> avatar-text: "HU";
    in-out property <color> avatar-color: Theme.blurple;
    in-out property <bool> is-muted: false;
    in-out property <bool> is-deafened: false;

    callback toggle-mute();
    callback toggle-deafen();
    callback open-settings();

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: space-between;

        // Avatar & Name area
        user-info := Rectangle {
            border-radius: 4px;
            background: user-info-touch.has-hover ? Theme.bg-hover : transparent;

            HorizontalLayout {
                spacing: 8px;
                padding-left: 4px;
                padding-right: 4px;
                alignment: start;

                // Avatar container
                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 10px;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.avatar-color;
                        clip: true;

                        if root.has-avatar: Image {
                            source: root.avatar-image;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.has-avatar: Text {
                            text: root.avatar-text;
                            color: Theme.text-white;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Online indicator dot
                    Rectangle {
                        x: 22px;
                        y: 22px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.green;
                        border-width: 2px;
                        border-color: Theme.bg-user-bar;
                    }
                }

                // Name and status text
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    width: 80px;

                    Text {
                        text: root.username;
                        color: Theme.text-white;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.user-status;
                        color: Theme.text-muted;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }

            user-info-touch := TouchArea {}
        }

        // Action Buttons: Mute, Deafen, Settings
        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            // Mic Mute Button
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: mic-touch.has-hover ? Theme.bg-hover : transparent;

                Text {
                    text: root.is-muted ? "🔇" : "🎤";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                mic-touch := TouchArea {
                    clicked => { root.toggle-mute(); }
                }
            }

            // Deafen Button
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: deaf-touch.has-hover ? Theme.bg-hover : transparent;

                Text {
                    text: root.is-deafened ? "🔇" : "🎧";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                deaf-touch := TouchArea {
                    clicked => { root.toggle-deafen(); }
                }
            }

            // Settings Button
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                background: set-touch.has-hover ? Theme.bg-hover : transparent;

                Text {
                    text: "⚙️";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                set-touch := TouchArea {
                    clicked => { root.open-settings(); }
                }
            }
        }
    }
}
